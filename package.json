{
  "name": "soloid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "SOLOID_COMMIT=$(git rev-parse HEAD) tsx watch src/server.ts",
    "build": "tsup src/server.ts src/cli.ts --format esm --target node22 --out-dir dist --clean && tailwindcss -i src/styles.css -o dist/app.css --minify",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "timing": "tsx scripts/timing.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@node-rs/argon2": "^2.2.2",
    "hono": "^4.13.23",
    "jose": "^6.2.18",
    "rate-limiter-flexible": "^11.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/semver": "^7.8.0",
    "openid-client": "^6.9.1",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
